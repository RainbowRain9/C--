{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "C++ Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set character encoding to UTF-8",
                    "text": "set target-charset UTF-8",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++ build"
        }
    ]
}