    "files.associations": {
        "iostream": "cpp",
        "ostream": "cpp",
        "new": "cpp",
        "array": "cpp",
        "atomic": "cpp",
        "*.tcc": "cpp",
        "cctype": "cpp",
        "clocale": "cpp",
        "cmath": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdint": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "cstring": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "deque": "cpp",
        "unordered_map": "cpp",
        "vector": "cpp",
        "exception": "cpp",
        "algorithm": "cpp",
        "functional": "cpp",
        "iterator": "cpp",
        "memory": "cpp",
        "memory_resource": "cpp",
        "numeric": "cpp",
        "optional": "cpp",
        "random": "cpp",
        "string": "cpp",
        "string_view": "cpp",
        "system_error": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "utility": "cpp",
        "fstream": "cpp",
        "initializer_list": "cpp",
        "iosfwd": "cpp",
        "istream": "cpp",
        "limits": "cpp",
        "sstream": "cpp",
        "stdexcept": "cpp",
        "streambuf": "cpp",
        "typeinfo": "cpp",
        "ctime": "cpp",
        "iomanip": "cpp",
        "climits": "cpp",
        "regex": "cpp",
        "bitset": "cpp",
        "cfenv": "cpp",
        "charconv": "cpp",
        "chrono": "cpp",
        "cinttypes": "cpp",
        "codecvt": "cpp",
        "complex": "cpp",
        "condition_variable": "cpp",
        "csetjmp": "cpp",
        "csignal": "cpp",
        "cuchar": "cpp",
        "forward_list": "cpp",
        "list": "cpp",
        "unordered_set": "cpp",
        "map": "cpp",
        "ratio": "cpp",
        "set": "cpp",
        "future": "cpp",
        "mutex": "cpp",
        "scoped_allocator": "cpp",
        "shared_mutex": "cpp",
        "thread": "cpp",
        "typeindex": "cpp",
        "valarray": "cpp",
        "queue": "cpp",
        "stack": "cpp",
        "*.cpp": "cpp"
    },
    "cSpell.words": [
        "atoi",
        "cbaebabacd",
        "cmath",
        "leetcode",
        "LLONG"
    ],
    // 头部注释
    "fileheader.customMade": {
        "Author": "git config user.name", // 同时获取用户名与邮箱
        "Date": "Do not edit", // 文件创建时间(不变)
        "LastEditTime": "Do not edit", // 文件最后编辑时间
        "FilePath": "Do not edit", // 文件在项目中的相对路径 自动更新
        "Description": "" // 介绍文件的作用、文件的入参、出参。
    },
    // 函数注释
    "fileheader.cursorMode": {
        "description": "", // 函数注释生成之后，光标移动到这里
        "param": "", // param 开启函数参数自动提取 需要将光标放在函数行或者函数上方的空白行
        "return": "",
    },
    "path-intellisense.mappings": {
        "@docs": "${workspaceFolder}/docs"
    },
    "todo-tree.general.tags": [
        "TODO",
        "LastEditTime",
        "今日",
        "本周",
        "历史"
    ],
    "todo-tree.general.tagGroups": {
        "时间": [
            "今日",
            "本周",
            "历史"
        ],
        "类型": [
            "TODO",
            "LastEditTime"
        ]
    },
    "todo-tree.regex.regex": "(s*TODO\\s*(\\d{4}-\\d{2}-\\d{2}))",
    "todo-tree.highlights.customHighlight": {
        "$TODO": {
            "icon": "pin",
            "foreground": "#5d30ff",
            "background": "#00000000",
            "iconColour": "#00000000",
            "type": "tag"
        },
        "LastEditTime": {
            "icon": "calendar",
            "foreground": "#6e5eff",
            "background": "#2196F3",
            "iconColour": "#2196F3",
            "type": "tag"
        },
        "今日": {
            "foreground": "#fff",
            "background": "#ffb86c",
            "regex": "\\d{4}-\\d{2}-\\d{2}\\s+(?:(?:0?[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9])$"
        },
        "本周": {
            "foreground": "#fff",
            "background": "#8be9fd",
            "regex": "\\d{4}-\\d{2}-\\d{2}"
        },
        "历史": {
            "foreground": "#fff",
            "background": "#ff79c6",
            "regex": "\\d{4}-\\d{2}(?:-\\d{2})?"
        }
    },
    "todo-tree.tree.showCountsInTree": true,
    "todo-tree.tree.showBadges": true,
    "todo-tree.tree.disableCompactFolders": true,
    "todo-tree.tree.expanded": true,
    "todo-tree.tree.scanMode": "workspace only",
    "todo-tree.highlights.useColourScheme": true,
    "todo-tree.tree.hideIconsWhenGroupedByTag": false,
    "todo-tree.tree.groupedByTag": false,
    "todo-tree.tree.groupedBySubTag": false,
    "clangd.arguments": [
        "--query-driver=D:\\MinGW\\mingw32\\bin\\g++.exe", // 替换为你的 g++ 路径
        "--background-index",
        "--compile-commands-dir=build", //compile_command.json相对路径，cmake默认生成在build，自行配置
        "-j=12",
        "--all-scopes-completion",
        "--completion-style=detailed",
        "--header-insertion=iwyu",
        "--pch-storage=memory",
        "--cross-file-rename",
        "--enable-config",
        "--fallback-style=WebKit",
        "--pretty",
        "--clang-tidy",
    ],
    "clangd.checkUpdates": false,
    "clangd.onConfigChanged": "ignore",
    "clangd.fallbackFlags": [
        "-std=c++17"
    ],
    "clangd.diagnostics": {
        "enabled": false
    }
}