# 编译生成的可执行文件
*.exe
*.out
*.o
*.obj

# 忽略基础学习目录中的可执行文件（无扩展名）
基础学习/*/01-*
基础学习/*/02-*
基础学习/*/03-*
基础学习/*/04-*
基础学习/*/05-*
基础学习/*/06-*
基础学习/*/07-*
基础学习/*/08-*
基础学习/*/09-*
基础学习/*/10-*

# 忽略所有目录中的无扩展名可执行文件（但保留源代码）
# 通过文件权限判断（可执行文件通常有执行权限）
**/[0-9][0-9]-*
!**/[0-9][0-9]-*.cpp
!**/[0-9][0-9]-*.c
!**/[0-9][0-9]-*.h

# 批处理文件
*.bat

# IDE和编辑器配置文件
.vscode/
.vs/
*.code-workspace

# 临时文件
*~
*.tmp
*.temp

# 系统文件
.DS_Store
Thumbs.db

# 调试文件
*.dSYM/
*.pdb

